<section id="contacto" class="oculto vh-100 d-flex flex-column justify-content-center align-items-center bg-dark position-relative pt-5">
    
    <h2 class="text-center mb-4 mt-4" style="font-size: 50px; font-family: 'Bebas Neue', sans-serif; color: goldenrod;">COTIZA TU VEHÍCULO</h2>
    
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                
                <form id="form-cotizacion">
                    
                    <div class="form-floating mb-3 text-dark">
                        <input type="text" class="form-control" id="floatingName" placeholder="Juan Perez">
                        <label for="floatingName">Nombre Completo</label>
                    </div>

                    <div class="form-floating mb-3 text-dark">
                        <input type="email" class="form-control" id="floatingEmail" placeholder="name@example.com">
                        <label for="floatingEmail">Correo Electrónico</label>
                    </div>

                    <div class="form-floating mb-3 text-dark">
                        <select class="form-select" id="floatingSelect" aria-label="Tipo de trámite">
                            <option selected>Selecciona un servicio</option>
                            <option value="1">Importación "Llave en Mano"</option>
                            <option value="2">Trámites Sertracen</option>
                        </select>
                        <label for="floatingSelect">¿En qué podemos ayudarte?</label>
                    </div>

                    <div class="form-floating mb-4 text-dark">
                        <textarea class="form-control" placeholder="Detalla el modelo, año y presupuesto" id="floatingTextarea" style="height: 120px"></textarea>
                        <label for="floatingTextarea">Detalles de tu vehículo ideal / Presupuesto / Servicio Requerido</label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-outline-warning btn-lg" style="font-family: 'Montserrat', sans-serif; font-weight: 600;">Enviar Cotización</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

<style>
    #contacto {
        scroll-snap-align: start;
        z-index: 1;
        box-sizing: border-box;
    }
</style>