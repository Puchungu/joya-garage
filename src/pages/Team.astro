<section class=" vh-100 d-flex flex-column justify-content-center align-items-center team-section bg-dark position-relative">
    <h1 id="nuestro-equipo" class="text-center mb-5">NUESTRO EQUIPO</h1>
    <div class="container oculto">
        <div class="row row-cols-1 row-cols-md-3 row-cols-xl-5 g-4">
            <div class="col">
                <div class="card h-100">
                    <img src="/joya.png" class="card-img-top" alt="FOTO DE DANIEL JOSUE JOYA MAJANO">
                    <div class="card-body bg-dark text-white border border-warning">
                        <h5 class="card-title text-warning">DANIEL JOYA </h5>
                        <p class="card-text">Aporte de $2,000 USD y su rol como Representante Legal / Administrador</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <img src="/nelson.jpeg" class="card-img-top" alt="FOTO DE NELSON OSWALDO ALVARENGA CUADRA">
                    <div class="card-body bg-dark text-white border border-warning">
                        <h5 class="card-title text-warning">NELSON ALVARENGA </h5>
                        <p class="card-text">Aporte de $2,000 USD </p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <img src="/mana.jpeg" class="card-img-top" alt="FOTO DE GERSON MANASES FLORES QUINTEROS">
