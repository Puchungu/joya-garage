                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <img src="/diego.png" class="card-img-top" alt="FOTO DE DIEGO ANTHONIO CABRERA GUEVARA">
                    <div class="card-body bg-dark text-white border border-warning">
                        <h5 class="card-title text-warning">DIEGO CABRERA </h5>
                        <p class="card-text">Aporte de $2,000 USD</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <img src="/pineda.png" class="card-img-top" alt="FOTO DE GERSON EZEQUIEL PINEDA ARGUETA">
                    <div class="card-body bg-dark text-white border border-warning">
                        <h5 class="card-title text-warning">GERSON PINEDA </h5>
                        <p class="card-text">Aporte de $2,000 USD</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .card-title {
        font-family: "Bebas Neue", sans-serif;
    }
    .card-text {
        font-family: "Montserrat", sans-serif;
    }
    #nuestro-equipo {
        font-size: 50px;
        font-family: "Bebas Neue", sans-serif;
        font-weight: 400;
        font-style: normal;
        color: goldenrod;
        margin-top: 50px;
    }
    .team-section{
        height: 100vh;
        scroll-snap-align: start;
        z-index: 1;
    }
    .card-img-top{
        height: 280px; 
        object-fit: cover;
    }
</style>
